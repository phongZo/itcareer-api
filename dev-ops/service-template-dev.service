[Unit]
Description=ITDream api service 

[Service]
#User=root #use user with restricted permissions
#Type=simple

ExecStart=/opt/jdk11/bin/java -Dfile.encoding=UTF-8 -Dspring.config.location={CONFIG_LOCATION}/ -Dspring.profiles.active={ENV} -Djava.security.egd=file:/dev/./urandom -jar {CONFIG_LOCATION}/app.jar
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier={APP_ID}
Restart=always

[Install]
WantedBy=multi-user.target